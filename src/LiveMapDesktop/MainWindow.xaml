<Window x:Class="LiveMapDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Minecraft LiveMap"
        Height="800" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                Padding="20,14"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Minecraft LiveMap"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="v1.0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Controls Bar -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                Padding="20,12"
                BorderBrush="#2a2a4e"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="World Seed:"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="SeedTextBox"
                         Width="320"
                         Style="{StaticResource DarkTextBox}"
                         KeyDown="SeedTextBox_KeyDown"/>
                <Button x:Name="LoadSeedButton"
                        Content="Load Seed"
                        Style="{StaticResource GoldButton}"
                        Margin="12,0,0,0"
                        Click="LoadSeedButton_Click"/>
            </StackPanel>
        </Border>

        <!-- WebView2 Map -->
        <Border Grid.Row="2"
                BorderBrush="#2a2a4e"
                BorderThickness="0">
            <wv2:WebView2 x:Name="MapWebView"
                          DefaultBackgroundColor="#1a1a2e"
                          MinWidth="400"
                          MinHeight="300"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                Padding="20,10"
                BorderBrush="#2a2a4e"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusEllipse" Width="10" Height="10" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text=" Initializing..."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
